{
  "name": "Thu chi gia đình",
  "short_name": "Thu chi",
  "description": "Sổ thu chi gia đình – chụp bill là tự ghi",
  "lang": "vi",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6fa",
  "theme_color": "#2448a8",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "bill",
          "accept": [
            "image/*",
            "application/pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".pdf"
          ]
        }
      ]
    }
  }
}